<?xml version="1.0" encoding="UTF-8"?>
<project name="ungoogled-chromium" basedir=".">

  <dirname property="app.basedir" file="${ant.file.ungoogled-chromium}"/>
  <property name="build.properties" value="${app.basedir}/build.properties"/>
  <property file="${build.properties}"/>

  <!-- Load Portapps core build -->
  <property name="core.basedir" location="${app.basedir}\${core.dir}"/>
  <fail unless="core.basedir" message="Core directory '${core.basedir}' not found in ${core.basedir}"/>
  <echo message="Core found in ${core.basedir}" level="debug"/>

  <!-- Import build-app.xml  -->
  <import file="${core.basedir}\.build\build-app.xml"/>

  <!-- Targets -->
  <target name="release" depends="release.app" description="Release"/>

  <target name="prepare">
    <echo message="Preparing release..."/>
    <!-- Extract the directory name from assertextract.

         assertextract = ungoogled-chromium_154.0.8037.57-1.1_windows_x64/chrome.exe

         Ant's <dirname> resolves relative paths to be absolute w.r.t. project
         basedir, so we need a second <basename> step to obtain only the
         directory component (ungoogled-chromium_154.0.8037.57-1.1_windows_x64).
         This makes the build resilient to upstream renames of the archive
         folder (e.g. from -1_Win64 to -1.1_windows_x64). -->
    <dirname file="${atf.win64.assertextract}" property="extract.dir.absolute"/>
    <basename file="${extract.dir.absolute}" property="extract.dir.name"/>
    <echo message="Extracted archive resolves to: ${extract.dir.name}"/>
    <fail message="Failed to determine extracted archive directory from ${atf.win64.assertextract} (${extract.dir.name})">
      <condition>
        <equals arg1="${extract.dir.name}" arg2="${atf.win64.assertextract}"/>
      </condition>
    </fail>
    <if>
      <equals arg1="${atf.arch}" arg2="win32"/>
      <then>
        <fail message="win32 branch deprecated; use assertextract-based resolution instead"/>
      </then>
      <else>
        <move todir="${extract.path}">
          <fileset dir="${extract.path}\${extract.dir.name}" defaultexcludes="no"/>
        </move>
      </else>
    </if>
  </target>

</project>
